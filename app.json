{
  "expo": {
    "name": "The SHED",
    "slug": "the-shed-mobile",
    "version": "2.9.29",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "theshedmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "au.org.sow.theshed",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:theshed.sow.org.au",
        "applinks:the-shed-web.vercel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "The SHED doesn't ask for your location. The Churches map only shows where churches are."
      }
    },
    "android": {
      "package": "au.org.sow.theshed",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "theshed.sow.org.au"
            },
            {
              "scheme": "https",
              "host": "the-shed-web.vercel.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F3E3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3E3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0B1D1B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow THE SHED to access your photos for profile pictures and receipt uploads."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { *; }\n-keep class androidx.work.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "xtectras-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee729ed9-3432-4e98-a8d3-dbc089a3d4ec"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ee729ed9-3432-4e98-a8d3-dbc089a3d4ec",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
