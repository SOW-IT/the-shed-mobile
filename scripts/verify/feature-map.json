    "package.json",
    "package-lock.json",
    ".gitignore",
    "app.json",
    "app.config.js",
    "babel.config.js",
    "fingerprint.config.js",
    "metro.config.js",
    "eas.json",
    "store.config.json",
    "tsconfig.json",
    "vercel.json",
    "assets/**",
    "web/**",
    "web/.vercelignore",
    "web/.well-known/**",
    "web-dev/.well-known/**",
    "src/app/_layout.tsx",
    "src/app/(tabs)/_layout.tsx",
    "src/app/(tabs)/index.tsx",
    "src/app/+html.tsx",
    "src/app/+not-found.tsx",
    "src/app/e2e-auth.tsx",
    "src/components/nav/**",
    "src/components/ui/**",
    "src/components/{ErrorBoundary,ErrorReporter,AppUpdatePrompt,OtaRestartOnResume,ChromeScreen,PagerScreen,PagerCarousel,PagerCarousel.native,GroupedList,FilterChips,DateInputs,DateInputs.web,WebDateTimeInput,NativeDateTimeField,ReorderableList,HistoryTimeline,CommentsSheet,CommentThreadSheet,SignInPrompt,CampusMark}.tsx",
    "src/components/{useTopBarCollapse,dateTimeDisplay}.ts",
    "src/theme.ts",
    "src/fonts.ts",
    "src/env.ts",
    "src/types/**",
    "src/lib/{errorReporting,appErrorKinds,staleRelease,restartHold,deviceStorage,navMenu,goBack,footerClearance,swipePage,sydneyTime,visibleColour,externalLinks,openExternalLink,notify,imageCacheKey,uploadLocalFile,csv,csvDownload,pdfWriter,universityLogos}.ts",
    "src/lib/pdfLibBundle.d.ts",
    "src/hooks/{useRestartHold,useReportAppVersion,useReportSeen,useHeldValue,useDebouncedValue,useMinuteTick,usePagedQuery,useListTopOnChange,useNavGroupOpen,useLandingTab,useCachedImageUri,useGoogleSignIn,useAppleSignIn,useBadgeSync}.ts",
    "convex/_generated/**",
    "convex/shared/**",
    "convex/tsconfig.json",
    "convex/env.d.ts",
    "convex/{environment,schema,auth,auth.config,http,crons,model,pagination,googleAuth,appleIdentity,appleRevoke,userLink,emails,comments,history,presence,actingAs,actingAsData,profile}.ts",
    "shared/{datetime,numbers,deepLinks,appLinks,typedConfirm,staffOnly,actingAs}.ts"
