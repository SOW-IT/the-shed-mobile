{
  "static": [
    "**/*.md",
    "docs/**",
    ".claude/**",
    ".cursor/**",
    ".github/**",
    ".vscode/**",
    "LICENSE",
    ".gitattributes",
    ".prettierignore",
    "eslint.config.js",
    ".coderabbit.yaml",
    "knip.jsonc",
    "skills-lock.json",
    "vitest.config.ts",
    "test/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "scripts/**",
    "convex/storageBackup.ts",
    "convex/cleanup.ts"
  ],
