{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://successful-lynx-56.ap-southeast-2.convex.cloud"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "staging": {
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_CONVEX_URL": "https://successful-lynx-56.ap-southeast-2.convex.cloud"
      },
      "channel": "staging"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://giant-bloodhound-191.ap-southeast-2.convex.cloud"
      },
      "channel": "production"
    }
  },
  "submit": {
    "preview": {},
    "staging": {
      "ios": {
        "ascAppId": "6781896563"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6781592871"
      }
    }
  }
}
